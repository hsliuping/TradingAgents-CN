# Frontend Dockerfile for Vue 3 + Vite app (TradingAgents-CN Pro)
#
# 构建方式:
#   1. 先在宿主机构建: cd frontend && npm run build
#   2. 再构建镜像: docker build -f docker/Dockerfile.frontend -t hsliup/tradingagents-pro-frontend:2.1.0 .

FROM nginx:alpine

WORKDIR /usr/share/nginx/html

# 复制宿主机构建产物
COPY frontend/dist .

# 复制Nginx配置（支持SPA路由）
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
