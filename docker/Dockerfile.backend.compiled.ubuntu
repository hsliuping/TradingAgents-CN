# Backend Dockerfile for FastAPI service (TradingAgents-CN Pro - Compiled Version for Ubuntu)
# 使用编译后的 .pyc 和 .pyd 文件，保护源码
# 支持多架构: amd64, arm64
# 
# 构建方式:
#   1. 在 Ubuntu 服务器上运行 docker/scripts/build-compile.sh
#   2. 脚本会自动编译代码并构建镜像
#
# 与 Dockerfile.backend.compiled 的区别:
#   - 不依赖本地 release/ 目录
#   - 使用构建脚本生成的临时编译目录
#   - 适合在 CI/CD 环境中使用

ARG BASE_IMAGE=hsliup/tradingagents-pro-backend-base:python3.11-bookworm
FROM ${BASE_IMAGE}

ARG COMPILE_DIR=docker/build/compiled

# 复制构建信息文件（如果存在）
COPY BUILD_INFO ./BUILD_INFO

# 安装基础镜像中可能缺失的依赖包
RUN pip install --no-cache-dir mem0ai -i https://pypi.tuna.tsinghua.edu.cn/simple

# 复制源码（将在构建时编译）
COPY app ./app
COPY core ./core
COPY tradingagents ./tradingagents

# 清理宿主机 __pycache__（避免版本不匹配的 .pyc 文件）
RUN find /app -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true && \
    find /app -name "*.pyc" -delete 2>/dev/null || true

# 复制编译脚本
COPY docker/scripts/compile-and-cleanup.sh /tmp/compile-and-cleanup.sh

# 安装 Cython 并执行编译和清理
RUN chmod +x /tmp/compile-and-cleanup.sh && \
    /tmp/compile-and-cleanup.sh && \
    rm -f /tmp/compile-and-cleanup.sh && \
    # 清理编译工具（减小镜像大小）
    apt-get purge -y gcc g++ python3-dev && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

# 复制配置文件和脚本（这些不需要编译）
COPY config ./config
COPY scripts/import_config_and_create_user.py ./scripts/import_config_and_create_user.py
COPY scripts/migrate_config_to_webapi.py ./scripts/migrate_config_to_webapi.py
COPY scripts/sync_financial_data.py ./scripts/sync_financial_data.py
COPY install ./install

# 复制运行时文档（v3.0 文档路径已调整，运行时不依赖这些文件，跳过复制）

# 复制 Docker Entrypoint 脚本
COPY docker/scripts/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# 复制 Docker 环境配置文件
COPY docker/.env.docker ./.env

# 🔐 安全：创建非 root 用户运行应用，避免容器内 root 权限泄露
# 使用固定 UID/GID 1000，便于宿主机目录权限对齐
# 安装 gosu 用于 entrypoint 中以 root 处理挂载卷权限后切换到 appuser
RUN apt-get update && apt-get install -y --no-install-recommends gosu && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --system --gid 1000 appuser && \
    useradd --system --uid 1000 --gid appuser \
        --home-dir /app --shell /usr/sbin/nologin appuser && \
    # 将 /app 目录所有权交给 appuser（含 logs/data/runtime/config 子目录）
    chown -R appuser:appuser /app && \
    # 确保 entrypoint 脚本可执行
    chmod +x /usr/local/bin/docker-entrypoint.sh

# 暴露后端端口
EXPOSE 8000

# Docker 环境标识
ENV DOCKER_CONTAINER=true \
    APP_USER=appuser \
    APP_UID=1000 \
    APP_GID=1000

# 使用 Entrypoint 脚本（自动初始化数据库）
# entrypoint 以 root 启动，chown 挂载卷后用 gosu 切换到 appuser 运行 CMD
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

# 启动 FastAPI 服务（实际以 appuser 身份运行，由 entrypoint 中的 gosu 切换）
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

