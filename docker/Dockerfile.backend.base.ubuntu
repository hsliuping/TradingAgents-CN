# Backend base Dockerfile for FastAPI service (TradingAgents-CN Pro)
# 提供后端发布镜像复用的公共基础层：系统依赖、编译工具和 Python 依赖

FROM python:3.11-slim-bookworm

ARG TARGETARCH
ARG APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
ARG APT_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TZ=Asia/Shanghai

WORKDIR /app

RUN mkdir -p /app/logs /app/data /app/config && \
    echo 'Acquire::Retries "3";' > /etc/apt/apt.conf.d/80-retries && \
    echo 'Acquire::ForceIPv4 "true";' >> /etc/apt/apt.conf.d/80-retries && \
    echo 'Acquire::http::Timeout "30";' >> /etc/apt/apt.conf.d/80-retries && \
    echo 'Acquire::https::Timeout "30";' >> /etc/apt/apt.conf.d/80-retries && \
    echo 'Acquire::http::Pipeline-Depth "0";' >> /etc/apt/apt.conf.d/80-retries && \
    rm -f /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources && \
    printf 'Types: deb\nURIs: %s\nSuites: bookworm bookworm-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n' "$APT_MIRROR" > /etc/apt/sources.list.d/debian.sources && \
    printf '\nTypes: deb\nURIs: %s\nSuites: bookworm-security\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n' "$APT_SECURITY_MIRROR" >> /etc/apt/sources.list.d/debian.sources && \
    (apt-get update || apt-get update || apt-get update) && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        fontconfig \
        fonts-noto-cjk \
        build-essential \
        gcc \
        g++ \
        gfortran \
        python3-dev \
        pkg-config \
        libffi-dev \
        libssl-dev \
        libxml2-dev \
        libxslt1-dev \
        liblapack-dev \
        libblas-dev \
        cython3 \
        wget \
        xvfb \
        libglib2.0-0 \
        libpango-1.0-0 \
        libcairo2 \
        libgdk-pixbuf-2.0-0 \
        libffi8 \
        shared-mime-info \
        libpangoft2-1.0-0 \
        libharfbuzz0b \
        libfribidi0 && \
    if [ -z "$TARGETARCH" ] || [ "$TARGETARCH" = "amd64" ]; then \
        PANDOC_ARCH="amd64"; \
    elif [ "$TARGETARCH" = "arm64" ]; then \
        PANDOC_ARCH="arm64"; \
    else \
        echo "Unsupported architecture: $TARGETARCH, using amd64"; \
        PANDOC_ARCH="amd64"; \
    fi && \
    echo "Building backend base for architecture: $TARGETARCH (PANDOC_ARCH=$PANDOC_ARCH)" && \
    PANDOC_URL="https://github.com/jgm/pandoc/releases/download/3.8.2.1/pandoc-3.8.2.1-1-${PANDOC_ARCH}.deb" && \
    if wget --no-verbose --tries=3 --timeout=30 "$PANDOC_URL" -O /tmp/pandoc.deb; then \
        dpkg -i /tmp/pandoc.deb || (apt-get install -f -y && dpkg -i /tmp/pandoc.deb); \
        rm -f /tmp/pandoc.deb; \
    else \
        echo "WARNING: Failed to download pandoc from GitHub, trying apt install..." && \
        apt-get install -y --no-install-recommends pandoc || echo "WARNING: pandoc installation failed, continuing without it"; \
    fi && \
    apt-get install -y --no-install-recommends wkhtmltopdf && \
    fc-cache -fv && \
    rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
RUN mkdir -p tradingagents && echo '__version__ = "0.0.0"' > tradingagents/__init__.py

RUN pip install --upgrade pip -i https://pypi.tuna.tsinghua.edu.cn/simple && \
    pip install --prefer-binary . -i https://pypi.tuna.tsinghua.edu.cn/simple && \
    pip install --prefer-binary pdfkit Cython -i https://pypi.tuna.tsinghua.edu.cn/simple && \
    rm -rf tradingagents