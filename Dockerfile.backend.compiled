# Backend Dockerfile for FastAPI service (TradingAgents-CN Pro - Compiled Version)
# 使用编译后的 .pyc 和 .pyd 文件，保护源码
# 支持多架构: amd64, arm64

ARG BASE_IMAGE=hsliup/tradingagents-pro-backend-base:python3.10-bookworm
FROM ${BASE_IMAGE}

# 获取构建架构信息
ARG TARGETARCH

# 复制编译后的代码（从便携版构建产物）
# 注意：需要先运行 build_portable_package.ps1 生成编译后的代码
COPY release/TradingAgentsCN-portable/app ./app
COPY release/TradingAgentsCN-portable/core ./core
COPY release/TradingAgentsCN-portable/tradingagents ./tradingagents

# 复制配置文件和脚本（这些不需要编译）
COPY config ./config
COPY scripts ./scripts
COPY docs ./docs
COPY install ./install

# 复制 Docker 环境配置文件
COPY .env.docker ./.env

RUN apt-get purge -y gcc g++ python3-dev && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

# 暴露后端端口
EXPOSE 8000

# Docker 环境标识
ENV DOCKER_CONTAINER=true

# 启动 FastAPI 服务
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

