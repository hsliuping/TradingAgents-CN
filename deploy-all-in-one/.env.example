# ==============================================================================
# TradingAgents-CN Pro 京东云部署环境变量
# ==============================================================================
# 使用方法:
#   1. 复制此文件为 .env (cp .env.example .env)
#   2. 填写以下必填项（标 🔧 的为必填）
#   3. docker-compose up -d
#   4. 访问 http://your-server:8082，用 admin/admin123 登录
# ==============================================================================

# ==================== 🔧 京东云模型服务（必填） ====================
# 京东云模型服务网关地址（OpenAI 兼容接口）
OPENAI_API_BASE=https://modelservice.jdcloud.com/v1

# 京东云提供的 API Key
OPENAI_API_KEY=pk-e2489f1e-8cc2-4d3a-9b51-714631ebddbf

# 默认对话模型
OPENAI_MODEL=GLM-5

# ==================== Embedding 模型 ====================
EMBEDDING_MODEL=Qwen3-Embedding-8B
EMBEDDING_API_BASE=https://modelservice.jdcloud.com/v1
EMBEDDING_API_KEY=pk-e2489f1e-8cc2-4d3a-9b51-714631ebddbf

# ==================== 🔧 数据源（必填） ====================
TUSHARE_TOKEN=57e078b604ed79821f313cb8d3b42a25e1ad7ff4147ebf4e05d2deee

# ==================== 数据库 ====================
# 🔐 生产环境请修改为强密码（至少 16 位）
MONGODB_PASSWORD=PLEASE_CHANGE_MONGO_PASSWORD

# ==================== 🔐 安全配置（必填） ====================
# 生产环境必须修改为随机字符串
# 生成方式: openssl rand -base64 48
JWT_SECRET=PLEASE_CHANGE_JWT_SECRET
CSRF_SECRET=PLEASE_CHANGE_CSRF_SECRET

# ==================== 部署参数 ====================
# 对外暴露端口
HOST_PORT=8082

# ==================== LLM 限速配置（可选） ====================
JDYUN_LLM_MAX_RETRIES=8
JDYUN_LLM_MAX_RPM=30
JDYUN_BATCH_MAX_CONCURRENT=1
JDYUN_WORKER_MAX_CONCURRENT=1
JDYUN_STOCK_INTERVAL_SECONDS=10
