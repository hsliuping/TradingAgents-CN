# TradingAgents-CN Pro Secret 模板
# ⚠️ 部署前请先用 base64 编码敏感数据
#   echo -n 'your-password' | base64

apiVersion: v1
kind: Secret
metadata:
  name: tradingagents-secrets
  namespace: tradingagents
  labels:
    app: tradingagents-cn-pro
type: Opaque
stringData:
  # MongoDB 密码（必填）
  MONGODB_PASSWORD: "REPLACE_WITH_YOUR_MONGODB_PASSWORD"

  # Redis 密码（可选）
  REDIS_PASSWORD: "REPLACE_WITH_YOUR_REDIS_PASSWORD"

  # Tushare Token（可选）
  TUSHARE_TOKEN: "REPLACE_WITH_YOUR_TUSHARE_TOKEN"

  # OpenAI 配置（京东云模式需要）
  OPENAI_API_KEY: "REPLACE_WITH_YOUR_OPENAI_API_KEY"
  OPENAI_API_BASE: "https://api.openai.com/v1"
  OPENAI_MODEL: "gpt-4"
