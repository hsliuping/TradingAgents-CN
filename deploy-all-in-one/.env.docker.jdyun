# ==============================================================================
# TradingAgents-CN Pro 单容器部署配置（京东云合作版）
# ==============================================================================
# 使用方法：
#   1. 填写京东云提供的参数（标 🔧 的为必填）
#   2. 运行：bash run.sh --jdyun
#   3. 浏览器访问 http://localhost:8082（通过京东云网关代理，Basic Auth 免密登录）
#
# 京东云版说明：
#   - 模型和数据源由京东云统一提供，用户无需在管理界面配置
#   - 管理界面中的「大模型配置」和「数据源配置」已隐藏
#   - 登录认证通过京东云网关注入 Basic Auth 实现，无需输入用户名密码
# ==============================================================================

# ------ 京东云模式（固定为 true）------
JDYUN_MODE=true

# ------ 🔧 京东云模型服务 ------
# 京东云模型服务网关地址
OPENAI_API_BASE=https://modelservice.jdcloud.com/v1
# 京东云提供的 API Key
OPENAI_API_KEY=pk-e2489f1e-8cc2-4d3a-9b51-714631ebddbf
# 默认对话模型（可选：GLM-5/GLM-5.1/GLM-5.2/DeepSeek-V4-Flash）
OPENAI_MODEL=GLM-5.1
# Embedding 模型（京东云固定提供）
EMBEDDING_MODEL=Qwen3-Embedding-8B
EMBEDDING_API_BASE=https://modelservice.jdcloud.com/v1
EMBEDDING_API_KEY=pk-e2489f1e-8cc2-4d3a-9b51-714631ebddbf

# ------ 🔧 数据源 ------
# 京东云提供的 Tushare Token
TUSHARE_TOKEN=57e078b604ed79821f313cb8d3b42a25e1ad7ff4147ebf4e05d2deee

# ------ MongoDB ------
MONGODB_PASSWORD=tradingagents123

# ------ 可选 ------
HOST_PORT=8082
# 单容器内部 MongoDB 暴露端口（默认 27019 会和 v3.0 开发库冲突，改为 27020）
MONGO_HOST_PORT=27020
TZ=Asia/Shanghai

# ------ 🔧 京东云 Basic Auth 认证 ------
# 京东云用户唯一标识:访问令牌（一用户一容器场景下配一条，多个用逗号分隔）
# 首次启动必须配置正确的凭据；后续 token 变化不影响老用户登录
# 示例：jcloud-ugidvcp:8437F13DABE87D0BC1D4DCCD4739C5A7
JDYUN_BASIC_AUTH_USERS=jcloud-ugidvcp:8437F13DABE87D0BC1D4DCCD4739C5A7

# ------ 京东云网关 IP 白名单（推荐配置）------
# 限制只有京东云网关的请求才能访问，防止外部伪造
# 多个 IP 用逗号分隔，支持 CIDR 格式（如 10.0.0.1,172.16.0.0/12）
# 留空则不启用 IP 校验（仅依赖网络隔离，不推荐生产环境）
JDYUN_GATEWAY_IPS=172.16.0.0/12,127.0.0.1
