# ==============================================================================
# TradingAgents-CN Pro 单容器部署配置（普通版）
# ==============================================================================
# 使用方法：
#   1. 修改 MONGODB_PASSWORD
#   2. 运行：bash run.sh
#   3. 浏览器访问 http://localhost:8082，用 admin/admin123 登录
#   4. 在「系统设置」中配置 API Key 和数据源
# ==============================================================================

# 【必填】MongoDB 密码
# 首次启动时用此密码创建管理员账户，启动后不可更改
MONGODB_PASSWORD=tradingagents123

# 【可选】容器对外端口
HOST_PORT=8082

# 【可选】时区
TZ=Asia/Shanghai
