#!/command/with-contenv bash
# nginx 服务 - 反向代理 + 静态资源服务

# nginx 默认以 master 进程 fork worker，需要用 daemon off 模式

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [nginx] $1" | tee -a /var/log/nginx/service.log
}

log "🚀 启动 Nginx（监听 ${NGINX_PORT:-8082}）..."

# 测试配置
nginx -t 2>&1 | tee -a /var/log/nginx/service.log

# 启动（前台运行）
exec nginx -g "daemon off; error_log /var/log/nginx/error.log warn;"
