#!/command/with-contenv bash
# init-data 服务 - 数据库初始化（oneshot）
#
# 流程：
#   1. 等待 MongoDB 就绪（transitionToAuth 或 auth 模式均可）
#   2. 检查/创建 admin root 用户
#   3. 如果处于 transitionToAuth 模式，切换到完全认证模式
#   4. 导入配置数据 + 创建默认业务用户
#   5. 创建标记文件
#
# 关键注意事项：
#   - MongoDB 的 ping 命令不需要认证！必须用 listDatabases 等命令测试认证
#   - admin 用户存在但密码错误时，需要用 updateUser 重置密码
#   - transitionToAuth → auth 的切换通过 s6 重启 mongod 实现

set -u

INIT_MARKER="/app/runtime/.config_imported"
MONGO_ADMIN_MARKER="/app/runtime/.mongo_admin_created"
LOG_FILE="/app/logs/init-data.log"

log() {
    local msg="$1"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [init-data] $msg" | tee -a "$LOG_FILE"
}

# 辅助函数：用认证连接测试（使用 listDatabases，而非 ping）
# ping 命令不需要认证，不能用来判断认证是否成功！
auth_test() {
    python3 -c "
import sys
from pymongo import MongoClient
from pymongo.errors import OperationFailure
try:
    client = MongoClient(
        'mongodb://${MONGODB_USERNAME}:${MONGODB_PASSWORD}@${MONGODB_HOST}:${MONGODB_PORT}/admin?authSource=${MONGODB_AUTH_SOURCE}',
        serverSelectionTimeoutMS=3000
    )
    # 使用 listDatabases 测试认证（必须认证才能执行）
    client.list_database_names()
    client.close()
    sys.exit(0)
except Exception:
    sys.exit(1)
" 2>/dev/null
}

# 辅助函数：用无认证连接测试（检查是否处于 transitionToAuth 模式）
# 使用 listDatabases 而非 ping
noauth_test() {
    python3 -c "
import sys
from pymongo import MongoClient
from pymongo.errors import OperationFailure
try:
    client = MongoClient('mongodb://${MONGODB_HOST}:${MONGODB_PORT}/', serverSelectionTimeoutMS=2000)
    # listDatabases 需要认证，如果成功说明处于 transitionToAuth 模式
    client.list_database_names()
    client.close()
    sys.exit(0)
except OperationFailure:
    # 被拒绝说明需要认证（完全认证模式）
    sys.exit(1)
except Exception:
    sys.exit(1)
" 2>/dev/null
}

log "=========================================="
log "🔧 检查数据库初始化状态"
log "=========================================="

# ------------------------------------------------------------------------------
# 1. 等待 MongoDB 就绪
# ------------------------------------------------------------------------------
log "⏳ 等待 MongoDB 就绪..."
MAX_RETRIES=60
RETRY=0
MONGO_READY=false

while [ $RETRY -lt $MAX_RETRIES ]; do
    # 先试认证连接
    if auth_test; then
        MONGO_READY=true
        log "   MongoDB 认证连接成功（完全认证模式）"
        break
    fi

    # 再试无认证连接（transitionToAuth 模式）
    if noauth_test; then
        MONGO_READY=true
        log "   MongoDB 无认证连接成功（transitionToAuth 模式）"
        break
    fi

    RETRY=$((RETRY + 1))
    if [ $((RETRY % 10)) -eq 0 ]; then
        log "   等待中... ($RETRY/$MAX_RETRIES)"
    fi
    sleep 1
done

if [ "$MONGO_READY" = false ]; then
    log "❌ MongoDB 连接超时（${MAX_RETRIES}秒）"
    exit 1
fi
log "✅ MongoDB 已就绪"

# ------------------------------------------------------------------------------
# 2. 等待 Redis 就绪（可选）
# ------------------------------------------------------------------------------
log "⏳ 等待 Redis 就绪..."
RETRY=0
REDIS_READY=false

while [ $RETRY -lt 30 ]; do
    if python3 -c "
import sys
import redis
try:
    r = redis.Redis(
        host='${REDIS_HOST}',
        port=${REDIS_PORT},
        password='${REDIS_PASSWORD:-}',
        socket_timeout=2
    )
    r.ping()
    sys.exit(0)
except Exception:
    sys.exit(1)
" 2>/dev/null; then
        REDIS_READY=true
        break
    fi
    RETRY=$((RETRY + 1))
    sleep 1
done

if [ "$REDIS_READY" = true ]; then
    log "✅ Redis 已就绪"
else
    log "⚠️  Redis 连接超时（继续，Redis 是可选服务）"
fi

# ------------------------------------------------------------------------------
# 3. 判断当前状态
# ------------------------------------------------------------------------------
log "🔍 检查 MongoDB 认证状态..."

TRANSITION_MODE=false   # 是否处于 transitionToAuth 模式
AUTH_WORKS=false        # admin 认证是否成功

# 先测试认证连接
if auth_test; then
    AUTH_WORKS=true
    log "   ✅ admin 认证连接成功"
else
    log "   ❌ admin 认证连接失败"
fi

# 测试无认证连接
if noauth_test; then
    TRANSITION_MODE=true
    log "   无认证可执行 listDatabases → 处于 transitionToAuth 模式"
else
    log "   无认证被拒绝 → 处于完全认证模式"
fi

# ------------------------------------------------------------------------------
# 4. 确保 admin root 用户存在且密码正确
# ------------------------------------------------------------------------------
# 三种情况：
#   A. AUTH_WORKS=true → admin 用户存在且密码正确，无需操作
#   B. AUTH_WORKS=false, TRANSITION_MODE=true → 需要创建或重置 admin 用户
#   C. AUTH_WORKS=false, TRANSITION_MODE=false → 密码错误且无法无认证连接（严重错误）

if [ "$AUTH_WORKS" = true ]; then
    log "✅ admin 用户认证正常，无需创建/重置"
else
    if [ "$TRANSITION_MODE" = false ]; then
        log "❌ 严重错误：admin 认证失败且不处于 transitionToAuth 模式"
        log "   可能原因：密码与 MONGODB_PASSWORD 环境变量不匹配"
        log "   解决方案：删除数据卷重新初始化，或手动修复密码"
        log "   继续启动（但数据库操作可能失败）..."
    else
        # transitionToAuth 模式：可以无认证操作
        log ""
        log "🔑 检查 admin 用户是否存在..."

        # 检查 admin 用户是否存在（无认证查询）
        ROOT_USER_EXISTS=$(python3 -c "
from pymongo import MongoClient
try:
    client = MongoClient('mongodb://${MONGODB_HOST}:${MONGODB_PORT}/', serverSelectionTimeoutMS=3000)
    users = list(client['admin']['system.users'].find({'user': '${MONGODB_USERNAME}'}))
    print('true' if users else 'false')
    client.close()
except Exception:
    print('false')
" 2>/dev/null)

        if [ "$ROOT_USER_EXISTS" = "true" ]; then
            # 用户存在但密码不对 → 重置密码
            log "   admin 用户已存在但密码不匹配，重置密码..."
            python3 -c "
import sys
from pymongo import MongoClient
try:
    client = MongoClient('mongodb://${MONGODB_HOST}:${MONGODB_PORT}/', serverSelectionTimeoutMS=3000)
    client.admin.command(
        'updateUser',
        '${MONGODB_USERNAME}',
        pwd='${MONGODB_PASSWORD}',
    )
    print('UPDATE_USER_OK')
    client.close()
except Exception as e:
    print(f'UPDATE_USER_FAIL: {e}', file=sys.stderr)
    sys.exit(1)
" 2>&1 | tee -a "$LOG_FILE"

            if grep -q "UPDATE_USER_OK" "$LOG_FILE" 2>/dev/null; then
                log "✅ admin 用户密码已重置"
            else
                log "❌ admin 用户密码重置失败"
            fi
        else
            # 用户不存在 → 创建
            log "   admin 用户不存在，创建..."
            python3 -c "
import sys
from pymongo import MongoClient
try:
    client = MongoClient('mongodb://${MONGODB_HOST}:${MONGODB_PORT}/', serverSelectionTimeoutMS=3000)
    client.admin.command(
        'createUser',
        '${MONGODB_USERNAME}',
        pwd='${MONGODB_PASSWORD}',
        roles=[
            {'role': 'root', 'db': 'admin'},
            {'role': 'userAdminAnyDatabase', 'db': 'admin'},
            {'role': 'readWriteAnyDatabase', 'db': 'admin'},
        ]
    )
    print('CREATE_USER_OK')
    client.close()
except Exception as e:
    if 'already exists' in str(e):
        print('USER_EXISTS')
    else:
        print(f'CREATE_USER_FAIL: {e}', file=sys.stderr)
        sys.exit(1)
" 2>&1 | tee -a "$LOG_FILE"

            if grep -q "CREATE_USER_OK\|USER_EXISTS" "$LOG_FILE" 2>/dev/null; then
                log "✅ admin root 用户创建成功"
            else
                log "❌ admin root 用户创建失败"
                exit 1
            fi
        fi

        # 验证：认证连接测试
        sleep 1
        if auth_test; then
            log "✅ admin 认证连接测试通过"
        else
            log "❌ admin 认证连接测试失败"
            exit 1
        fi
    fi
fi

# ------------------------------------------------------------------------------
# 5. 从 transitionToAuth 切换到完全认证模式
# ------------------------------------------------------------------------------
if [ "$TRANSITION_MODE" = true ]; then
    log ""
    log "🔐 切换到完全认证模式..."

    # 写入标记文件（mongod 重启后会检查此文件）
    echo "$(date -u +'%Y-%m-%d %H:%M:%S UTC')" > "$MONGO_ADMIN_MARKER"
    chown appuser:appuser "$MONGO_ADMIN_MARKER"
    log "   标记文件: $MONGO_ADMIN_MARKER"

    # 触发 mongod 重启（s6 会重启 mongod，mongod 检查标记后使用 --auth 模式）
    log "   触发 mongod 重启..."
    RESTART_TRIGGERED=false

    # 方法1: s6-svc -r (restart)
    if command -v s6-svc &> /dev/null; then
        if s6-svc -r /var/run/s6/services/mongodb 2>/dev/null; then
            log "   ✅ 已通过 s6-svc -r 触发 mongodb 重启"
            RESTART_TRIGGERED=true
        fi
    fi

    if [ "$RESTART_TRIGGERED" = false ]; then
        # 方法2: 直接 kill（s6 会自动重启）
        MONGOD_PID=""
        if command -v pidof &> /dev/null; then
            MONGOD_PID=$(pidof mongod 2>/dev/null | awk '{print $1}')
        fi
        if [ -z "$MONGOD_PID" ]; then
            if [ -f /var/run/mongodb.pid ]; then
                MONGOD_PID=$(cat /var/run/mongodb.pid 2>/dev/null)
            fi
        fi
        if [ -n "$MONGOD_PID" ]; then
            kill -TERM "$MONGOD_PID" 2>/dev/null || true
            log "   ⚠️  使用 kill 方式触发重启（PID: $MONGOD_PID）"
            RESTART_TRIGGERED=true
        else
            log "   ❌ 找不到 mongod 进程，无法触发重启"
        fi
    fi

    # 等待 mongod 重启完成
    log "   等待 mongod 重启就绪（带认证模式）..."
    MAX_WAIT=30
    WAIT=0
    while [ $WAIT -lt $MAX_WAIT ]; do
        sleep 1
        WAIT=$((WAIT + 1))
        if auth_test; then
            log "   ✅ mongod 已就绪（完全认证模式）"
            break
        fi
    done

    if [ $WAIT -eq $MAX_WAIT ]; then
        log "   ⚠️  mongod 重启超时（$MAX_WAIT 秒）"
    fi

    # 验证：无认证应该被拒绝（用 listDatabases，不是 ping）
    log ""
    log "🔍 验证 MongoDB 认证状态..."
    if noauth_test; then
        log "   ⚠️  mongod 仍接受无认证连接（可能仍在 transitionToAuth 模式）"
        log "      容器仍可正常使用：bind 127.0.0.1 + 单用户场景，无横向风险"
    else
        log "   ✅ mongod 已拒绝无认证连接（完全认证模式生效）"
    fi
fi

# ------------------------------------------------------------------------------
# 6. 检查是否需要导入业务数据
# ------------------------------------------------------------------------------
SHOULD_INIT=true
INIT_REASON="未找到初始化标记文件"

if [ -f "$INIT_MARKER" ]; then
    # 检查业务数据库中是否有 admin 业务用户
    if python3 -c "
import sys
from pymongo import MongoClient
try:
    client = MongoClient(
        'mongodb://${MONGODB_USERNAME}:${MONGODB_PASSWORD}@${MONGODB_HOST}:${MONGODB_PORT}/${MONGODB_DATABASE}?authSource=${MONGODB_AUTH_SOURCE}',
        serverSelectionTimeoutMS=3000
    )
    user = client['${MONGODB_DATABASE}']['users'].find_one({'username': 'admin'}, {'_id': 1})
    client.close()
    sys.exit(0 if user else 1)
except Exception:
    sys.exit(1)
" 2>/dev/null; then
        log "✅ 数据库已初始化（标记 + admin 业务用户）"
        SHOULD_INIT=false
    else
        log "⚠️  标记文件存在但 admin 业务用户不存在，重新初始化"
        rm -f "$INIT_MARKER"
        INIT_REASON="陈旧标记，已移除并重新执行"
    fi
fi

# ------------------------------------------------------------------------------
# 7. 执行初始化（如果需要）
# ------------------------------------------------------------------------------
if [ "$SHOULD_INIT" = true ]; then
    log ""
    log "📦 开始初始化数据库..."
    log "   原因: $INIT_REASON"

    # 查找最新的配置导出文件
    CONFIG_DIR="/app/install"
    LATEST_CONFIG=$(find "$CONFIG_DIR" -name "database_export_config_*.json" -type f 2>/dev/null | sort -r | head -n 1)

    cd /app

    if [ -n "$LATEST_CONFIG" ] && [ -f "$LATEST_CONFIG" ]; then
        log "   使用配置: $LATEST_CONFIG"

        # 执行初始化（以 appuser 运行，使用 admin 认证连接）
        if gosu appuser python3 scripts/import_config_and_create_user.py "$LATEST_CONFIG" >> "$LOG_FILE" 2>&1; then
            log "✅ 数据库初始化完成"

            # 写入标记
            echo "$(date -u +'%Y-%m-%d %H:%M:%S UTC')" > "$INIT_MARKER"
            chown appuser:appuser "$INIT_MARKER"
            log "   标记文件: $INIT_MARKER"
        else
            log "⚠️  数据库初始化失败，查看日志: $LOG_FILE"
            log "   服务将继续启动，你可以稍后手动执行："
            log "   docker exec -it <container> python3 scripts/import_config_and_create_user.py"
        fi
    else
        log "⚠️  未找到配置文件 (database_export_config_*.json)"
        log "   仅创建默认用户..."

        if gosu appuser python3 scripts/import_config_and_create_user.py --create-user-only >> "$LOG_FILE" 2>&1; then
            log "✅ 默认用户已创建"
            echo "$(date -u +'%Y-%m-%d %H:%M:%S UTC')" > "$INIT_MARKER"
            chown appuser:appuser "$INIT_MARKER"
        else
            log "⚠️  默认用户创建失败"
        fi
    fi
else
    log "ℹ️  跳过初始化（数据库已有数据）"
fi

# ------------------------------------------------------------------------------
# 8. 导入预生成的能力索引状态（首次启动时）
# ------------------------------------------------------------------------------
# 能力索引的指纹和 document_hashes 存在 MongoDB 中（capability_index_state 集合）。
# 全新部署时数据库为空，没有状态 -> ensure_index() 会全量重建（323 次 embedding 请求）。
# 从种子导入状态后，指纹匹配 -> 跳过重建，秒级可用。
CAP_STATE_SEED="/app/qdrant-seed/capability_index_state.json"

if [ -f "$CAP_STATE_SEED" ]; then
    # 检查 capability_index_state 是否已有数据
    STATE_EXISTS=$(python3 -c "
import sys
from pymongo import MongoClient
try:
    client = MongoClient(
        'mongodb://${MONGODB_USERNAME}:${MONGODB_PASSWORD}@${MONGODB_HOST}:${MONGODB_PORT}/${MONGODB_DATABASE}?authSource=${MONGODB_AUTH_SOURCE}',
        serverSelectionTimeoutMS=3000
    )
    doc = client['${MONGODB_DATABASE}']['capability_index_state'].find_one({'_id': 'default'})
    client.close()
    print('true' if doc else 'false')
except Exception:
    print('false')
" 2>/dev/null)

    if [ "$STATE_EXISTS" = "false" ]; then
        log "📦 导入预生成的能力索引状态..."
        if gosu appuser python3 -c "
import json
from pymongo import MongoClient
client = MongoClient(
    'mongodb://${MONGODB_USERNAME}:${MONGODB_PASSWORD}@${MONGODB_HOST}:${MONGODB_PORT}/${MONGODB_DATABASE}?authSource=${MONGODB_AUTH_SOURCE}',
    serverSelectionTimeoutMS=5000
)
with open('$CAP_STATE_SEED', 'r') as f:
    state = json.load(f)
# 确保 _id 正确
state['_id'] = 'default'
client['${MONGODB_DATABASE}']['capability_index_state'].replace_one(
    {'_id': 'default'}, state, upsert=True
)
client.close()
print('OK')
" 2>&1 | tee -a "$LOG_FILE" | grep -q "OK"; then
            log "   ✅ 能力索引状态已导入（指纹 + 309 个工具索引）"
        else
            log "   ⚠️ 能力索引状态导入失败（首次启动将全量重建）"
        fi
    else
        log "ℹ️  能力索引状态已存在，跳过导入"
    fi
fi

log ""
log "=========================================="
log "✅ init-data 完成"
log "=========================================="
