#!/command/with-contenv bash
# backend 服务 - 启动 FastAPI 后端

cd /app

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [backend] $1" | tee -a /app/logs/backend.log
}

# 加载 init 阶段生成的密钥
if [ -f /app/runtime/env.sh ]; then
    log "🔐 加载 JWT/CSRF 密钥..."
    source /app/runtime/env.sh
fi

log "🚀 启动 FastAPI 后端服务..."

# 使用 gosu 降权到 appuser
exec gosu appuser python3 -m uvicorn \
    app.main:app \
    --host 127.0.0.1 \
    --port ${BACKEND_PORT:-8000} \
    --log-level info \
    --no-server-header
