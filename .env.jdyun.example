# ==============================================================================
# TradingAgents-CN Pro 京东云合作版环境变量示例
# ==============================================================================
# 使用方法：
#   1. 复制此文件为 .env.jdyun (cp .env.jdyun.example .env.jdyun)
#   2. 填写京东云提供的参数（标 🔧 的为必填）
#   3. 启动：bash deploy-all-in-one/run.sh --jdyun
#   4. 浏览器访问 http://localhost:8082，用 admin/admin123 登录
#
# 京东云版说明：
#   - 模型和数据源由京东云统一提供，用户无需在管理界面配置
#   - 管理界面中的「大模型配置」和「数据源配置」已隐藏
#   - 仅支持 A 股市场，港股/美股功能已暂停
#
# 完整文档：docs/02-user-guide/getting-started/portable-installation-guide.md
# ==============================================================================


# ==================== 京东云模式开关（固定为 true） ====================
# 启用京东云合作版模式，隐藏 Provider/数据源配置界面
# 首次启动时自动初始化 jdyun Provider、4 个预置模型、Tushare 数据源和 Embedding 配置
JDYUN_MODE=true


# ==================== 🔧 京东云模型服务（必填） ====================
# 京东云模型服务网关地址（OpenAI 兼容接口）
OPENAI_API_BASE=https://modelservice.jdcloud.com/v1

# 京东云提供的 API Key（请替换为真实值）
OPENAI_API_KEY=

# 默认对话模型（可选：GLM-5 / GLM-5.1 / GLM-5.2 / DeepSeek-V4-Flash）
# 首次启动后可在前端「系统配置 → 京东云模型」页面切换
OPENAI_MODEL=GLM-5

# Embedding 模型（用于 mem0 记忆系统，京东云固定提供 Qwen3-Embedding-8B）
# 输出维度 4096，Qdrant collection 会自动匹配
EMBEDDING_MODEL=Qwen3-Embedding-8B


# ==================== 🔧 数据源（必填） ====================
# 京东云提供的 Tushare Token
# AKShare 是开源免费数据源，无需配置 Token，始终可用
TUSHARE_TOKEN=


# ==================== MongoDB 数据库 ====================
# 单容器内部 MongoDB，仅本机访问
# 🔐 生产环境请修改为强密码（至少 16 位）
# 生成方式：openssl rand -base64 24
MONGODB_PASSWORD=PLEASE_CHANGE_MONGO_PASSWORD

# MongoDB 认证数据库（默认 admin，通常无需修改）
MONGODB_AUTH_SOURCE=admin


# ==================== Redis 缓存（可选） ====================
# 单容器内部 Redis，仅本机访问
# 默认无密码，如需密码请取消注释并在容器内 redis.conf 中同步配置
# REDIS_PASSWORD=


# ==================== JWT / CSRF 安全配置（可选但强烈推荐修改） ====================
# 🔐 生产环境必须修改为随机字符串（至少 32 字符）
# 生成方式：openssl rand -base64 48
# 🚫 禁止使用默认值，否则非 DEBUG 模式下系统将拒绝启动
# JWT_SECRET=PLEASE_CHANGE_JWT_SECRET
# CSRF_SECRET=PLEASE_CHANGE_CSRF_SECRET


# ==================== LLM 限速配置（应对京东云 API 限速，可选） ====================
# 这些参数针对京东云 API 的限速策略做了优化，默认值已能应对大多数场景
# 仅在遇到 429 错误或需要调整并发时修改

# LLM 调用最大重试次数（京东云 429 限速时自动指数退避重试）
JDYUN_LLM_MAX_RETRIES=8

# LLM 每分钟最大请求数（用于限速器配置）
JDYUN_LLM_MAX_RPM=30

# 批量分析最大并发数（京东云模式默认 1，避免 LLM 限速）
JDYUN_BATCH_MAX_CONCURRENT=1

# Worker 最大并发任务数（京东云模式默认 1，避免 LLM 限速）
JDYUN_WORKER_MAX_CONCURRENT=1

# 定时分析股票间的间隔秒数（避免短时间内大量 LLM 调用触发限速）
JDYUN_STOCK_INTERVAL_SECONDS=10


# ==================== Token 配额（可选） ====================
# Token 配额上限（0 表示不限额）
# 当配置为非 0 值时，仪表板"API 用量"卡片会显示已用/配额百分比和进度条
# 配额为 0 时仅展示累计用量，不显示进度条
# 单位：Token（输入 + 输出累计）
JDYUN_TOKEN_QUOTA=0


# ==================== 部署参数（可选） ====================
# 对外暴露的 nginx 端口（容器内 nginx 监听 8082）
HOST_PORT=8082

# 时区
TZ=Asia/Shanghai

# 调试模式（生产环境务必设为 false）
DEBUG=false


# ==================== 启动方式 ====================
# 启动：bash deploy-all-in-one/run.sh --jdyun
# 停止：bash deploy-all-in-one/run.sh --stop
# 查看日志：bash deploy-all-in-one/run.sh --logs
# 进入容器：bash deploy-all-in-one/run.sh --shell
# 查看状态：bash deploy-all-in-one/run.sh --status
