# ============================================================================
# Electron 国内镜像配置
# 加速 Electron 和 electron-builder 相关依赖的下载
# ============================================================================

# Electron 主程序下载镜像（npmmirror.com 阿里云镜像）
ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/

# Electron Builder 二进制文件下载镜像
ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/

# 通用 npm 镜像（加速 npm 包下载）
registry=https://registry.npmmirror.com/

# 以下镜像也会被 electron-builder 使用：
# WIN_CODE_SIGN_MIRROR 等不需要单独配置，npmmirror 已包含

# 严格 SSL（国内镜像建议关闭以加速）
strict-ssl=false

# 增加网络超时时间（防止大文件下载超时）
timeout=120000
