{
  "name": "AITrading",
  "version": "1.0.0",
  "description": "TradingAgents-CN 桌面应用程序 - 多智能体股票分析学习平台",
  "author": "TradingAgents-CN Team",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "build:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.tradingagents.cn.desktop",
    "productName": "AITrading",
    "copyright": "Copyright © 2024 TradingAgents-CN Team",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "dist/**/*"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": null,
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": null,
      "category": "public.app-category.finance",
      "artifactName": "${productName}-${version}-mac.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "${productName}-${version}-mac.dmg"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "asar": true,
    "compression": "maximum",
    "removePackageScripts": true,
    "nodeGypRebuild": false,
    "npmRebuild": false
  }
}